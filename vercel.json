{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/shared/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/portal",
      "destination": "/internal/login.html",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/internal/login.html",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/internal/dashboard.html",
      "permanent": false
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "mould-curing"
        }
      ],
      "destination": "/produk/mould-curing",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "bonding-agent"
        }
      ],
      "destination": "/produk/bonding-agent",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "grouting"
        }
      ],
      "destination": "/produk/grouting",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "mortar-admixture"
        }
      ],
      "destination": "/produk/mortar-admixture",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "ready-mix-mortar"
        }
      ],
      "destination": "/produk/ready-mix-mortar",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "waterproofing"
        }
      ],
      "destination": "/produk/waterproofing",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "floor-treatments"
        }
      ],
      "destination": "/produk/floor-treatments",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "tile-adhesive"
        }
      ],
      "destination": "/produk/tile-adhesive",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "concrete-admixture"
        }
      ],
      "destination": "/produk/concrete-admixture",
      "permanent": true
    },
    {
      "source": "/produk-detail",
      "destination": "/produk",
      "permanent": true
    }
  ]
}
